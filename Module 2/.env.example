# Copy this file to .env and replace the placeholder values.
# Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-replace-me
LITELLM_MASTER_KEY=sk-replace-with-random-master-key
LITELLM_SALT_KEY=sk-replace-with-random-salt-key
POSTGRES_PASSWORD=replace-with-random-postgres-password
DATABASE_URL=postgresql://litellm:replace-with-random-postgres-password@db:5432/litellm
# Optional troubleshooting only. Leave disabled normally.
# LITELLM_LOG=DEBUG
